# Production is the default deployment profile. Demo records are never auto-created.
RMS_ENV=production
# Copy to .env. Never commit .env or use these placeholder values in production.
# Generate each secret independently with: openssl rand -base64 48
RMS_SECRET_KEY=
RMS_SETUP_TOKEN=

# Host directory mounted at /data in the single application container.
# Create it and give UID 1000 write access before docker compose up.
# Holds control.db (platform registry) and one database per restaurant under
# tenants/<code>/rms.db. Back up all of them together.
RMS_DATA_DIR=./data
# Optional overrides; both default to files inside RMS_DATA_DIR.
# RMS_CONTROL_DB_PATH=./data/control.db
# RMS_DB_PATH=./data/rms.db
RMS_BACKUP_DIR=./backups
RMS_BACKUP_RETENTION_DAYS=30

# Optional: an IAM-role-authenticated S3 destination for encrypted off-site copies.
# Example: s3://your-private-backup-bucket/rms
RMS_BACKUP_S3_URI=

# Platform (super admin) first-run. Either create the first platform account in
# the browser at /platform using RMS_SETUP_TOKEN, or provide credentials here and
# RMS creates the account at boot (it never overwrites an existing one).
RMS_PLATFORM_EMAIL=
RMS_PLATFORM_PASSWORD=
RMS_PLATFORM_NAME=

# The PIN pad lists restaurant codes/names so staff can pick their store.
# Set to 0 on a shared deployment to require typing the code instead.
RMS_TENANT_DIRECTORY=0

# Remove/blank RMS_SETUP_TOKEN after the one-time browser setup, then restart.
# Optional provider credentials. Non-empty values override and stay out of SQLite.
RMS_SMTP_PASSWORD=
RMS_SFTP_PRIVATE_KEY=
RMS_TWILIO_AUTH_TOKEN=
RMS_SENDGRID_API_KEY=
RMS_DOORDASH_API_KEY=
RMS_UBEREATS_API_KEY=

# Explicit literal IP allowlist for manager device TCP checks; discovery is disabled.
RMS_HARDWARE_ALLOWED_IPS=
