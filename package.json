{
  "name": "rms",
  "version": "2.0.0",
  "private": true,
  "description": "Multi-role Restaurant Management System — Front of House, Back of House, Back Office and Customer Self-Service",
  "type": "module",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p ${PORT:-3000}",
    "build": "next build",
    "postbuild": "node scripts/clean-standalone.mjs",
    "start": "bash scripts/start-standalone.sh",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset": "vite-node scripts/reset-db.ts",
    "db:seed": "vite-node scripts/seed.ts",
    "db:backup": "node --experimental-strip-types --no-warnings scripts/backup-sqlite.ts",
    "tenant:create": "vite-node scripts/create-restaurant.ts"
  },
  "dependencies": {
    "next": "15.5.29",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.15.3",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vite-node": "6.0.0",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
}
